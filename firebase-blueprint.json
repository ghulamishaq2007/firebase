{
  "entities": {
    "products": {
      "title": "Products",
      "description": "Store products with real-time stock levels, pricing, status, and details.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "Canonical product identifier" },
        "productName": { "type": "string", "description": "Display name of the product" },
        "productUrl": { "type": "string", "description": "Relative product HTML URL" },
        "image": { "type": "string", "description": "Product image filename or URL" },
        "price": { "type": "number", "description": "Authoritative price in PKR" },
        "stock": { "type": "number", "description": "Authoritative live stock quantity" },
        "status": { "type": "string", "enum": ["available", "out_of_stock"], "description": "Stock status" },
        "category": { "type": "string", "description": "Product category" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp of last stock update" }
      },
      "required": ["productId", "productName", "price", "stock", "status"]
    },
    "orders": {
      "title": "Orders",
      "description": "Customer orders placed via direct WhatsApp checkout with 30-minute cancellation window and stock deduction.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "description": "Formatted unique order ID (e.g. ZV-20260920-0001)" },
        "customerName": { "type": "string", "description": "Customer full name" },
        "phone": { "type": "string", "description": "Pakistani mobile number" },
        "province": { "type": "string", "description": "Province or region" },
        "city": { "type": "string", "description": "Delivery city" },
        "area": { "type": "string", "description": "Delivery area or locality" },
        "address": { "type": "string", "description": "Full street address" },
        "items": { "type": "array", "description": "Ordered items with verified prices and quantities" },
        "total": { "type": "number", "description": "Calculated total price in PKR" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Preparing", "Shipped", "Delivered", "Cancelled"], "description": "Order status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Order placement server timestamp" },
        "cancellationDeadline": { "type": "string", "format": "date-time", "description": "30 minutes from creation" },
        "cancelledAt": { "type": "string", "format": "date-time", "description": "Timestamp when customer cancelled order" },
        "stockRestored": { "type": "boolean", "description": "Flag indicating stock has already been restored upon cancellation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last modified timestamp" }
      },
      "required": ["orderId", "customerName", "phone", "province", "city", "area", "address", "items", "total", "status", "createdAt", "cancellationDeadline"]
    },
    "adminUsers": {
      "title": "Admin Users",
      "description": "Authorized administrators permitted to manage stock, prices, and orders.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Admin email address" },
        "role": { "type": "string", "enum": ["admin"], "description": "Role permission" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["email", "role"]
    }
  }
}
